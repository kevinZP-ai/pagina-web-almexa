@startuml
title RF1 - Gestión de Usuarios

|Usuario|
start
:Solicitar acceso al sistema;

if (¿Tiene cuenta registrada?) then (no)
  |Administrador|
  :Registrar usuario (ERF1.1);
  |Usuario|
else (sí)
endif

:Ingresar credenciales (ERF1.2);

|Sistema|
if (¿Credenciales válidas?) then (sí)
  :Iniciar sesión;
else (no)
  |Usuario|
  if (¿Olvidó su contraseña?) then (sí)
    :Solicitar restablecimiento de contraseña (ERF1.3);
    |Sistema|
    :Enviar código/enlace de restablecimiento;
    |Usuario|
    :Definir nueva contraseña;
    |Sistema|
    :Actualizar credenciales;
  else (no)
    :Mostrar mensaje de error de autenticación;
    stop
  endif
endif

|Usuario|
:Acceder al sistema;
:Modificar sus datos de perfil;

|Administrador|
:Modificar datos del usuario (ERF1.4);
:Listar y buscar usuarios (ERF1.6);
if (¿Usuario debe ser desactivado?) then (sí)
  :Desactivar usuario (ERF1.5);
else (no)
endif

stop
@enduml
